# Supabase (já existentes — usados no futuro para Auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Postgres do Supabase — Project Settings → Database → Connect
# Runtime da app: pooler em transaction mode (porta 6543)
DATABASE_URL="postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres"
# Prisma CLI (migrate / seed / studio): conexão direta ou session pooler (porta 5432)
DIRECT_URL="postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres"

# ATENÇÃO: o seed APAGA todos os dados. Só mude para true quando quiser resetar o banco.
SEED_ALLOW_RESET=false
