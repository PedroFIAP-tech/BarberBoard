// BarberBoard — schema do MVP
//
// Convenções:
// - Valores monetários em CENTAVOS (Int). Ex.: R$ 45,90 = 4590.
// - Taxas em BASIS POINTS (Int). Ex.: 1,99% = 199.
// - Instantes (data + hora) em timestamptz; datas de calendário em @db.Date.
// - Tabelas e colunas em snake_case no banco, camelCase no código.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum PaymentMethod {
  PIX
  CASH
  DEBIT
  CREDIT
}

/// Origem do lançamento: digitado no BarberBoard ou importado do App Barber.
enum EntrySource {
  MANUAL
  APP_BARBER
}

/// Serviço (principal) ou Extra. Os relatórios quebram o faturamento em
/// Serviço (MAIN), Extra (EXTRA) e Produto.
enum ServiceCategory {
  MAIN
  EXTRA
}

/// CLASSIFIED: a visita tem itens que somam o total. PENDING ("a classificar"): visita importada
/// sem itens (o App Barber só exporta o total); o barbeiro escolhe os itens depois.
enum ClassificationStatus {
  CLASSIFIED
  PENDING
}

/// Situação de uma comanda "a confirmar" (barbeiro que não fecha comanda no App Barber).
/// PENDING: aguardando. CONFIRMED: virou visita paga. CLUB: virou visita de assinante (R$ 0).
/// NO_SHOW: cliente não veio. CANCELLED: cancelada no App Barber enquanto PENDING.
/// Só PENDING muda na reimportação; os demais nunca voltam.
enum ConfirmationStatus {
  PENDING
  CONFIRMED
  CLUB
  NO_SHOW
  CANCELLED
}

/// PENDING: prévia gerada, aguardando confirmação. COMPLETED: visitas criadas. FAILED: erro ao confirmar.
enum ImportStatus {
  PENDING
  COMPLETED
  FAILED
}

// ─── Cadastros ──────────────────────────────────────────────────────────────

model Barber {
  id                   String   @id @default(cuid())
  name                 String
  /// Como o barbeiro aparece na coluna "Profissional" do App Barber (ex.: "PH", "L.F").
  appBarberCode        String?  @unique @map("app_barber_code")
  /// false = barbeiro que não fecha comanda no App Barber (Paulo): as comandas dele são ignoradas
  /// na importação e as visitas entram por lançamento manual.
  importsFromAppBarber Boolean  @default(true) @map("imports_from_app_barber")
  active               Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz

  appointments         Appointment[]
  expenses             Expense[]
  pendingConfirmations PendingConfirmation[]

  @@map("barbers")
}

model Service {
  id                String          @id @default(cuid())
  name              String          @unique
  category          ServiceCategory @default(MAIN)
  defaultPriceCents Int             @map("default_price_cents")
  durationMin       Int?            @map("duration_min")
  active            Boolean         @default(true)
  sortOrder         Int             @default(0) @map("sort_order")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  items     AppointmentItem[]
  ruleItems PriceRuleItem[]

  @@map("services")
}

/// Produtos vendidos no balcão (pomada, óleo...). Sem controle de estoque por enquanto.
model Product {
  id         String   @id @default(cuid())
  name       String   @unique
  priceCents Int      @map("price_cents")
  /// Preço de custo (opcional). Produto sem custo fica fora do cálculo de margem.
  costCents  Int?     @map("cost_cents")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  items     AppointmentItem[]
  ruleItems PriceRuleItem[]

  @@map("products")
}

/// Taxa da maquininha por forma de pagamento (uma linha por método).
model PaymentFee {
  id        String        @id @default(cuid())
  method    PaymentMethod @unique
  feeBps    Int           @default(0) @map("fee_bps")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@map("payment_fees")
}

model ExpenseCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  expenses Expense[]

  @@map("expense_categories")
}

// ─── Movimento ──────────────────────────────────────────────────────────────

/// Uma VISITA do cliente (pode ter vários itens). Ticket médio = soma(totalCents) / nº de visitas.
/// feeBps/feeCents/netCents são congelados no lançamento: mudar a taxa depois não altera o histórico.
/// Invariante (garantida pelo código que grava visitas, ver assertVisitItemsConsistent em
/// src/domain/import-preview.ts): CLASSIFIED ⇒ itens somam totalCents; PENDING ⇒ nenhum item.
model Appointment {
  id                     String               @id @default(cuid())
  performedAt            DateTime             @map("performed_at") @db.Timestamptz
  barberId               String               @map("barber_id")
  paymentMethod          PaymentMethod        @map("payment_method")
  feeBps                 Int                  @map("fee_bps")
  totalCents             Int                  @map("total_cents")
  feeCents               Int                  @map("fee_cents")
  netCents               Int                  @map("net_cents")
  notes                  String?
  source                 EntrySource          @default(MANUAL)
  externalId             String?              @map("external_id")
  importBatchId          String?              @map("import_batch_id")
  classification         ClassificationStatus @default(CLASSIFIED)
  /// true = horário não informado (lançamento manual de dia passado sem hora). Conta em todos os
  /// totais, mas fica FORA do mapa de dias/horários do dashboard.
  performedAtApproximate Boolean              @default(false) @map("performed_at_approximate")
  /// Visita de assinante do clube: total 0 (a mensalidade é paga à parte). Conta em clientes e no
  /// ranking de serviços, mas fica fora do ticket médio.
  subscriptionVisit      Boolean              @default(false) @map("subscription_visit")
  /// Regra de valor usada para gerar os itens (ex.: "Corte e sobrancelha"), para o ranking.
  priceRuleId            String?              @map("price_rule_id")
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  barber       Barber               @relation(fields: [barberId], references: [id], onDelete: Restrict)
  importBatch  ImportBatch?         @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  priceRule    PriceRule?           @relation(fields: [priceRuleId], references: [id], onDelete: SetNull)
  items        AppointmentItem[]
  confirmation PendingConfirmation?

  @@unique([source, externalId])
  @@index([performedAt])
  @@index([barberId, performedAt])
  @@index([classification, performedAt])
  @@map("appointments")
}

/// Cada serviço OU produto de uma visita.
/// Exatamente um entre serviceId e productId é preenchido — garantido por CHECK
/// constraint escrita à mão na migration (o Prisma não gera CHECK).
/// Preço e custo ficam congelados no lançamento: mudar o catálogo não altera o histórico.
model AppointmentItem {
  id             String   @id @default(cuid())
  appointmentId  String   @map("appointment_id")
  serviceId      String?  @map("service_id")
  productId      String?  @map("product_id")
  quantity       Int      @default(1)
  unitPriceCents Int      @map("unit_price_cents")
  /// Custo unitário do produto no momento da venda (null em serviços e em produto sem custo).
  unitCostCents  Int?     @map("unit_cost_cents")
  totalCents     Int      @map("total_cents")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service?    @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  product     Product?    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([appointmentId])
  @@index([serviceId])
  @@index([productId])
  @@map("appointment_items")
}

/// Regra de sugestão por valor: "comanda de R$ 50 = Corte (R$ 40) + Sobrancelha (R$ 10)".
/// Um valor com exatamente uma regra ativa gera os itens automaticamente na importação;
/// sem regra ou com mais de uma, a visita fica PENDING ("a classificar").
/// A soma dos itens tem que ser igual a amountCents (validado em src/domain/price-rules.ts).
model PriceRule {
  id          String   @id @default(cuid())
  /// Nome como aparece no App Barber (ex.: "Corte e sobrancelha").
  label       String
  amountCents Int      @map("amount_cents")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  items        PriceRuleItem[]
  appointments Appointment[]

  @@index([amountCents])
  @@map("price_rules")
}

/// Item de uma regra: um serviço OU um produto (CHECK escrita à mão na migration),
/// com o preço que ele assume dentro da regra (pode diferir do preço do catálogo).
model PriceRuleItem {
  id             String   @id @default(cuid())
  ruleId         String   @map("rule_id")
  serviceId      String?  @map("service_id")
  productId      String?  @map("product_id")
  quantity       Int      @default(1)
  unitPriceCents Int      @map("unit_price_cents")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  rule    PriceRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  service Service?  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  product Product?  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([ruleId])
  @@map("price_rule_items")
}

model Expense {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  categoryId  String   @map("category_id")
  amountCents Int      @map("amount_cents")
  description String?
  /// Opcional: usado para comissão paga a um barbeiro.
  barberId    String?  @map("barber_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  barber   Barber?         @relation(fields: [barberId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([categoryId, date])
  @@map("expenses")
}

/// Conferência de caixa do dia. Guarda o snapshot do que era esperado em dinheiro
/// e do que foi contado na gaveta. Bruto/líquido/ticket são calculados dos atendimentos.
model CashClosing {
  id                String   @id @default(cuid())
  date              DateTime @unique @db.Date
  /// Fundo de troco que já estava na gaveta no início do dia.
  openingCashCents  Int      @default(0) @map("opening_cash_cents")
  /// openingCashCents + atendimentos em dinheiro do dia.
  expectedCashCents Int      @map("expected_cash_cents")
  countedCashCents  Int      @map("counted_cash_cents")
  /// counted - expected (negativo = faltou dinheiro).
  differenceCents   Int      @map("difference_cents")
  notes             String?
  closedAt          DateTime @default(now()) @map("closed_at") @db.Timestamptz
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("cash_closings")
}

// ─── Importação do App Barber ───────────────────────────────────────────────

/// Uma importação do Histórico de Comandas. Enquanto PENDING, `meta.rows` guarda as linhas
/// normalizadas da prévia (sem Cliente, Cadastro nem Finalização); ao confirmar, as linhas
/// saem do meta e ficam só as contagens e os erros por linha.
model ImportBatch {
  id                String       @id @default(cuid())
  source            EntrySource
  fileName          String       @map("file_name")
  status            ImportStatus @default(PENDING)
  rowCount          Int          @default(0) @map("row_count")
  /// Fechadas novas que viraram visita.
  importedCount     Int          @default(0) @map("imported_count")
  /// Das importadas, quantas ficaram "a classificar".
  unclassifiedCount Int          @default(0) @map("unclassified_count")
  /// Fechadas já importadas antes (mesmo externalId).
  duplicateCount    Int          @default(0) @map("duplicate_count")
  /// Abertas com data passada: "finalize no App Barber".
  openPastCount     Int          @default(0) @map("open_past_count")
  /// Abertas com data futura (agendamentos).
  openFutureCount   Int          @default(0) @map("open_future_count")
  cancelledCount    Int          @default(0) @map("cancelled_count")
  /// Fechadas com vários profissionais ("L.F + 1") que precisam de revisão.
  reviewCount       Int          @default(0) @map("review_count")
  /// Comandas novas de barbeiros que não fecham comanda (Paulo): vão para "a confirmar".
  toConfirmCount    Int          @default(0) @map("to_confirm_count")
  errorCount        Int          @default(0) @map("error_count")
  meta              Json?
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  appointments         Appointment[]
  pendingConfirmations PendingConfirmation[]

  @@map("import_batches")
}

/// Comanda do App Barber de barbeiro que não fecha comanda (Paulo): fica "a confirmar" e NÃO conta
/// em nenhuma soma (faturamento, fechamento, dashboard) até virar visita. Ao confirmar, cria-se um
/// Appointment (source APP_BARBER, externalId = comanda) e esta linha guarda o vínculo.
model PendingConfirmation {
  id                String             @id @default(cuid())
  /// Número da comanda no App Barber (chave da reimportação).
  externalId        String             @unique @map("external_id")
  barberId          String             @map("barber_id")
  scheduledAt       DateTime           @map("scheduled_at") @db.Timestamptz
  valueCents        Int                @map("value_cents")
  /// Obs da comanda (pode ter nome do cliente; nunca em logs). "club" sugere visita de assinante.
  notes             String?
  /// Forma de pagamento, quando a comanda veio Fechada (só sugestão).
  paymentMethodHint PaymentMethod?     @map("payment_method_hint")
  status            ConfirmationStatus @default(PENDING)
  appointmentId     String?            @unique @map("appointment_id")
  importBatchId     String?            @map("import_batch_id")
  resolvedAt        DateTime?          @map("resolved_at") @db.Timestamptz
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  barber      Barber       @relation(fields: [barberId], references: [id], onDelete: Restrict)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt])
  @@index([barberId, scheduledAt])
  @@map("pending_confirmations")
}
